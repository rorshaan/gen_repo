<div class="accordion" id="filesAccordion-<%= association %>") %>
  <% @import_files.each_with_index do |file, index| %>
    <% if file.public_send(association).any? %>
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-<%= index %>">
          <button class="accordion-button <%= index > 0 ? 'collapsed' : '' %>" 
                  type="button" 
                  data-bs-toggle="collapse" 
                  data-bs-target="#collapse-<%= index %>" 
                  aria-expanded="<%= index == 0 %>" 
                  aria-controls="collapse-<%= index %>">
            File: <%= File.basename(file.file_path) %> 
            | Uploaded by: <%= file.user.email %> 
            | Rows: <%= file.public_send(association).size %>
          </button>
        </h2>

        <div id="collapse-<%= index %>" 
             class="accordion-collapse collapse <%= index == 0 ? 'show' : '' %>" 
             aria-labelledby="heading-<%= index %>" 
             data-bs-parent="#filesAccordion-<%= association %>">
          <div class="accordion-body">
            <div class="table-responsive">
              <table class="table table-striped table-bordered table-hover align-middle">
                <thead class="table-primary">
                  <tr>
                    <% headers.each do |header| %>
                      <th><%= header %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <% file.public_send(association).each do |record| %>
                    <%= render partial: row_partial, locals: { record: record } %>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
