<turbo-frame id="content_frame">
  <div class="card">
    <div class="card-header">
      <% if file.present? %>
        <strong><%= file.channel_name %></strong> — <%= File.basename(file.file_path.to_s) %>
        <span class="float-end text-muted">
          Rows: <%= file.total_rows || "-" %> | Status: <%= file.status %>
        </span>
        <%= link_to "Download File", download_import_file_path(file.id), 
                class: "btn btn-sm btn-success m-1",
                download: File.basename(file.file_path) %>
      <% else %>
        <strong><%= channel %></strong> — All Records
      <% end %>
    </div>

    <div class="card-header">
      <div class="mb-2">
          <% if params[:filter_open] == "true" %>
            <%= link_to "Close Filters",
                        storage_model_path(channel: @channel_name, filter_open: "false"),
                        class: "btn btn-outline-secondary btn-sm",
                        data: { turbo_frame: "content_frame" } %>
          <% else %>
            <%= link_to "Open Filters",
                        storage_model_path(channel: @channel_name, filter_open: "true"),
                        class: "btn btn-outline-secondary btn-sm",
                        data: { turbo_frame: "content_frame" } %>
          <% end %>
        </div>
    </div>

    <div class="card-body p-2">
      <% channel_name = file.present? ? file.channel_name : channel %>

      <% filter_fields = StorageController::FILTER_FIELDS[channel_name] %>
      <div class="collapse<%= 'show' if params[:filter_open] == "true" || filter_fields&.any? { |f| params[f].present? } %>"" id="filterCollapse">
        <div class="mb-3">
          <%= form_with url: storage_model_path(model_name: channel_name), method: :get, data: { turbo_frame: "content_frame" } do %>
            <%= hidden_field_tag :channel, channel_name %>
            <%= hidden_field_tag :page, 1 %>
            <%= hidden_field_tag :file_date, params[:file_date] %>
            <%= hidden_field_tag :filter_open, "true" %>

            <div class="row g-2 align-items-end">
              <% filter_fields.each do |f| %>
                <% value = params[f] %>
                <% case f
                   when :transaction_id, :receipt_no, :reference_number, :transfer_id %>
                  <div class="col-lg-3">
                    <%= label_tag f, f.to_s.humanize + ' ID' %>
                    <%= text_field_tag f, value, class: "form-control", placeholder: "Search #{f.to_s.humanize + ' ID'}" %>
                  </div>
                <% when :status %>
                  <div class="col-lg-3">
                    <%= label_tag f, "Status" %>
                    <%= select_tag f, options_for_select(["Success", "Failed"], value), include_blank: "All", class: "form-select" %>
                  </div>
                <% when :transaction_amount, :amount %>
                  <div class="col-lg-3">
                    <%= label_tag f, "Sort Amount" %>
                    <%= select_tag f, options_for_select(["Ascending", "Descending"], value), include_blank: "Select", class: "form-select" %>
                  </div>
                <% when :start_date, :end_date %>
                  <div class="col-lg-3">
                    <%= label_tag f, f.to_s.humanize %>
                    <%= date_field_tag f, value, class: "form-control" %>
                  </div>
                <% when :file_id %>
                  <% if files.present? %>
                    <div class="col-lg-3">
                      <%= label_tag f, "File" %>
                      <%= select_tag f, options_from_collection_for_select(files, "id", "file_path", value), include_blank: "All Files", class: "form-select" %>
                    </div>
                  <% end %>
                <% end %>
              <% end %>
              <div class="col-lg-3 d-flex gap-2">
                <%= submit_tag "Apply Filter", class: "btn btn-primary" %>
                <%= link_to "Clear Filters", storage_model_path(model_name: channel_name, filter_open: "true"), class: "btn btn-outline-secondary" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <% if records.present? %>
        <% if channel_name == "Channel One" %>
          <!-- Channel One table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render "records/#{channel_name.gsub(" ", "").underscore}/header" %>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Two" %>
          <!-- Channel Two table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render "records/#{channel_name.gsub(" ", "").underscore}/header" %>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Three" %>
          <!-- Channel Three table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/header"%>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Four" %>
          <!-- Channel Three table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/header"%>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Five" %>
          <!-- Channel Three table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/header"%>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Six" %>
          <!-- Channel Three table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/header"%>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% else %>
          <div class="alert alert-info">No table template for channel: <%= channel_name %></div>
        <% end %>
      <% else %>
        <div class="alert alert-warning mb-0">
          <% if params[:search].present? %>
            No transactions found for transaction id <%= params[:search] %>.
          <% else %>
            No transactions found.
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-2">
    <%= paginate @records %>
  </div>
</turbo-frame>
