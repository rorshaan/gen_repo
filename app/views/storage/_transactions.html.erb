<turbo-frame id="content_frame">
  <div class="card">
    <div class="card-header">
      <strong><%= file.channel_name %></strong> — <%= File.basename(file.file_path.to_s) %>
      <span class="float-end text-muted">Rows: <%= file.total_rows || "-" %> | Status: <%= file.status %></span>
    </div>
    <div class="card-body p-2">
      <div class="d-flex justify-content-between">
        <div class="mb-3">
          <%= form_with url: storage_path(file.id, channel: file.channel_name), method: :get, data: { turbo_frame: "content_frame" }, id: "search_form" do %>
            <%= hidden_field_tag :channel, file.channel_name %> <!-- preserves channel -->
            <%= hidden_field_tag :page, 1 %> <!-- resets pagination -->

            <div class="input-group">
              <%= text_field_tag :search, params[:search], placeholder: "Search Transaction ID", class: "form-control", id: "search_input" %>
              <button class="btn btn-primary" type="submit">Search</button>
            </div>
          <% end %>
        </div>

        <div class="mb-2">
          <span>Sort by Amount:</span>
          <%= link_to "Ascending", storage_path(file.id, channel: file.channel_name, search: params[:search], sort: "asc"), data: { turbo_frame: "content_frame" }, class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "Descending", storage_path(file.id, channel: file.channel_name, search: params[:search], sort: "desc"), data: { turbo_frame: "content_frame" }, class: "btn btn-sm btn-outline-secondary" %>
        </div>
      </div>

      <% if records.present? && records.any? %>
        <% if file.channel_name == "Channel One" %>
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <tr>
                  <th>Transaction ID</th>
                  <th>Sender Msisdn</th>
                  <th>Amount
                    <%= link_to storage_path(file.id, channel: file.channel_name, search: params[:search], sort: (params[:sort] == "asc" ? "desc" : "asc")), data: { turbo_frame: "content_frame" }, class: "ms-1 text-decoration-none" do %>
                      <% if params[:sort] == "asc" %>
                        <i class="bi bi-sort-up ms-4"></i>
                      <% else %>
                        <i class="bi bi-sort-down ms-4"></i>
                      <% end %>
                    <% end %>
                  </th>
                  <th>Date & Time</th>
                  <th>Type</th>
                  <th>Receiver</th>
                  <th>Status</th>
                  <th>Reference Number</th>
                  <th>Previous Balance</th>
                  <th>Post Balance</th>
                  <th>External Transaction ID</th>
                </tr>
              </thead>
              <tbody>
                <% records.each do |rec| %>
                  <tr>
                    <td><%= rec.transaction_id %></td>
                    <td><%= rec.sender_msisdn %></td>
                    <td><%= rec.transaction_amount %></td>
                    <td><%= rec.transaction_datetime&.strftime("%d-%m-%Y %H:%M") %></td>
                    <td><%= rec.transaction_type %></td>
                    <td><%= rec.receiver_msisdn %></td>
                    <td>
                      <% if rec.transaction_status.to_s.downcase.include?("success") %>
                        <span class="badge bg-success">Success</span>
                      <% else %>
                        <span class="badge bg-danger"><%= rec.transaction_status %></span>
                      <% end %>
                    </td>
                    <td><%= rec.reference_number %></td>
                    <td><%= rec.previous_balance %></td>
                    <td><%= rec.post_balance %></td>
                    <td><%= rec.external_transaction_id %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

        <% elsif file.channel_name == "Channel Two" %>
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <tr>
                  <th>Receipt No.</th>
                  <th>Completion Time</th>
                  <th>Initiation Time</th>
                  <th>Details</th>
                  <th>Status</th>
                  <th>Currency</th>
                  <th>Paid In</th>
                  <th>Withdrawn</th>
                  <th>Balance</th>
                  <th>Reason Type</th>
                  <th>Opposite Party</th>
                  <th>Linked Transaction ID</th>
                </tr>
              </thead>
              <tbody>
                <% records.each do |rec| %>
                  <tr>
                    <td><%= rec.receipt_no %></td>
                    <td><%= rec.completion_time&.strftime("%d-%m-%Y %H:%M") %></td>
                    <td><%= rec.initiation_time&.strftime("%d-%m-%Y %H:%M") %></td>
                    <td><%= rec.details %></td>
                    <td>
                      <% if rec.transaction_status.to_s.downcase.include?("success") %>
                        <span class="badge bg-success">Success</span>
                      <% else %>
                        <span class="badge bg-danger"><%= rec.transaction_status %></span>
                      <% end %>
                    </td>
                    <td><%= rec.currency %></td>
                    <td><%= rec.paid_in %></td>
                    <td><%= rec.withdrawn %></td>
                    <td><%= rec.balance %></td>
                    <td><%= rec.reason_type %></td>
                    <td><%= rec.opposite_party %></td>
                    <td><%= rec.linked_transaction_id %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

        <% else %>
          <div class="alert alert-info">No table template for channel: <%= file.channel_name %></div>
        <% end %>

      <% else %>
        <div class="alert alert-warning mb-0">No transactions found for this transaction id <%= params[:search] %>.</div>
      <% end %>
    </div>
  </div>
  <div class="d-flex justify-content-center mt-2">
      <%= paginate @records %>
  </div>
</turbo-frame>
<script>
  document.addEventListener("turbo:frame-load", (event) => {
  if (event.target.id === "content_frame") {
    const searchInput = document.getElementById("search_input");
    if (searchInput) {
      searchInput.value = ""; // reset the input
    }
  }
});
</script>