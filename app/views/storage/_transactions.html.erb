<turbo-frame id="content_frame">
  <div class="card">
    <div class="card-header">
      <% if file.present? %>
        <strong><%= file.channel_name %></strong> — <%= File.basename(file.file_path.to_s) %>
        <span class="float-end text-muted">
          Rows: <%= file.total_rows || "-" %> | Status: <%= file.status %>
        </span>
        <%= link_to "Download File", download_import_file_path(file.id), 
                class: "btn btn-sm btn-success m-1",
                download: File.basename(file.file_path) %>
      <% else %>
        <strong><%= channel %></strong> — All Records
      <% end %>
    </div>

    
    <div class="card-header">
      <!-- Toggle Filters Button -->
      <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
        Toggle Filters
      </button>
    </div>
   

    <div class="card-body p-2">
      <% channel_name = file.present? ? file.channel_name : channel %>

      <div class="collapse" id="filterCollapse">
        <div class="mb-3">
          <%= form_with url: storage_model_path(model_name: channel_name),
                        method: :get,
                        data: { turbo_frame: "content_frame" },
                        id: "search_form" do %>
            <%= hidden_field_tag :channel, file.present? ? file.channel_name : channel %>
            <%= hidden_field_tag :page, 1 %>
            <%= hidden_field_tag :file_date, params[:file_date] %>

            <div class="row g-2 align-items-end">
              <!-- Transaction ID -->
              <div class="col-lg-3">
                <%= label_tag :transaction_id, "Transaction ID", class: "form-label" %>
                <%= text_field_tag :transaction_id, params[:transaction_id], class: "form-control", placeholder: "Search Transaction Id" %>
              </div>

              <!-- Reference Number -->
              <div class="col-lg-3">
                <%= label_tag :reference_number, "Reference ID", class: "form-label" %>
                <%= text_field_tag :reference_number, params[:reference_number], class: "form-control", placeholder: "Search Reference Id" %>
              </div>

              <!-- Date Range -->
              <div class="col-lg-3">
                <%= label_tag :start_date, "Start Date", class: "form-label" %>
                <%= date_field_tag :start_date, params[:start_date], class: "form-control" %>
              </div>
              <div class="col-lg-3">
                <%= label_tag :end_date, "End Date", class: "form-label" %>
                <%= date_field_tag :end_date, params[:end_date], class: "form-control" %>
              </div>

              <!-- Status -->
              <div class="col-lg-3">
                <%= label_tag :status, "Status", class: "form-label" %>
                <%= select_tag :status, options_for_select(["Success", "Failed"], params[:status]), include_blank: "Select", class: "form-select" %>
              </div>

              <div class="col-lg-3">
                <%= label_tag :transaction_amount, "Amount", class: "form-label" %>
                <%= select_tag :transaction_amount, options_for_select(["Ascending", "Descending"], params[:transaction_amount]), include_blank: "Select", class: "form-select" %>
              </div>

              <!-- File Dropdown -->
              <% if files.present? %>
                <div class="col-lg-3">
                  <%= label_tag :file_id, "File", class: "form-label" %>
                  <%= select_tag :file_id, options_from_collection_for_select(files, "id", "file_path", params[:file_id]), include_blank: "All Files", class: "form-select" %>
                </div>
              <% end %>

              <div class="col-lg-3">
                <%= submit_tag "Apply Filter", class: "btn btn-primary" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <% if records.present? %>
        <% if channel_name == "Channel One" %>
          <!-- Channel One table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render "records/#{channel_name.gsub(" ", "").underscore}/header" %>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Two" %>
          <!-- Channel Two table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render "records/#{channel_name.gsub(" ", "").underscore}/header" %>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Three" %>
          <!-- Channel Three table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/header"%>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Four" %>
          <!-- Channel Three table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/header"%>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Five" %>
          <!-- Channel Three table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/header"%>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% elsif channel_name == "Channel Six" %>
          <!-- Channel Three table -->
          <div class="overflow-auto" style="max-width: 100%; white-space: nowrap;">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/header"%>
              </thead>
              <tbody>
                <%= render partial: "records/#{channel_name.gsub(" ", "").underscore}/row", collection: @records, as: :record %>
              </tbody>
            </table>
          </div>

        <% else %>
          <div class="alert alert-info">No table template for channel: <%= channel_name %></div>
        <% end %>
      <% else %>
        <div class="alert alert-warning mb-0">
          <% if params[:search].present? %>
            No transactions found for transaction id <%= params[:search] %>.
          <% else %>
            No transactions found.
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-center mt-2">
    <%= paginate @records %>
  </div>
</turbo-frame>
