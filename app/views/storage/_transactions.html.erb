<turbo-frame id="content_frame">
  <div class="card">
    <div class="card-header">
      <strong><%= file.channel_name %></strong> — <%= File.basename(file.file_path.to_s) %>
      <span class="float-end text-muted">Rows: <%= file.total_rows || "-" %> | Status: <%= file.status %></span>
    </div>
    <div class="card-body p-2">
      <% if records.present? && records.any? %>
        <% if file.channel_name == "Channel One" %>
          <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <tr>
                  <th>Transaction ID</th>
                  <th>Sender Msisdn</th>
                  <th>Amount</th>
                  <th>Date & Time</th>
                  <th>Type</th>
                  <th>Receiver</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <% records.each do |rec| %>
                  <tr>
                    <td><%= rec.transaction_id %></td>
                    <td><%= rec.sender_msisdn %></td>
                    <td><%= rec.transaction_amount %></td>
                    <td><%= rec.transaction_datetime&.strftime("%d-%m-%Y %H:%M") %></td>
                    <td><%= rec.transaction_type %></td>
                    <td><%= rec.receiver_msisdn %></td>
                    <td>
                      <% if rec.transaction_status.to_s.downcase.include?("success") %>
                        <span class="badge bg-success">Success</span>
                      <% else %>
                        <span class="badge bg-danger"><%= rec.transaction_status %></span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

        <% elsif file.channel_name == "Channel Two" %>
          <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped mb-0">
              <thead class="table-primary">
                <tr>
                  <th>Receipt No.</th>
                  <th>Completion Time</th>
                  <th>Initiation Time</th>
                  <th>Details</th>
                  <th>Status</th>
                  <th>Currency</th>
                  <th>Paid In</th>
                  <th>Withdrawn</th>
                  <th>Balance</th>
                </tr>
              </thead>
              <tbody>
                <% records.each do |rec| %>
                  <tr>
                    <td><%= rec.receipt_no %></td>
                    <td><%= rec.completion_time&.strftime("%d-%m-%Y %H:%M") %></td>
                    <td><%= rec.initiation_time&.strftime("%d-%m-%Y %H:%M") %></td>
                    <td><%= rec.details %></td>
                    <td>
                      <% if rec.transaction_status.to_s.downcase.include?("success") %>
                        <span class="badge bg-success">Success</span>
                      <% else %>
                        <span class="badge bg-danger"><%= rec.transaction_status %></span>
                      <% end %>
                    </td>
                    <td><%= rec.currency %></td>
                    <td><%= rec.paid_in %></td>
                    <td><%= rec.withdrawn %></td>
                    <td><%= rec.balance %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

        <% else %>
          <div class="alert alert-info">No table template for channel: <%= file.channel_name %></div>
        <% end %>

      <% else %>
        <div class="alert alert-warning mb-0">No transactions found for this file.</div>
      <% end %>
    </div>
  </div>
  <div class="d-flex justify-content-center mt-2">
      <%= paginate @records %>
    </div>
</turbo-frame>
