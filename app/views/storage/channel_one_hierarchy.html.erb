<div class="container mt-3">
  <div class="col-lg-12">
    <div class="card text-center mb-2">
      <div class="card-header">
        <h3 >Channel One Transactions</h3>
      </div>
    </div>
  </div>
  <div class="row">
    <% @tree.each do |category, channels| %>
      <div class="col-md-6 mb-3">
        <div class="card text-center mb-2">
          <div class="card-header">
            <h5 ><%= category %></h5>
          </div>
        
          <div class="card-body">
            <div class="accordion" id="accordion-<%= category.parameterize %>">
              <% channels.each_with_index do |(channel_last4, months), ch_idx| %>
                <div class="accordion-item mb-1">
                  <h2 class="accordion-header" id="heading-channel-<%= ch_idx %>">
                    <button class="accordion-button collapsed py-1" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse-channel-<%= ch_idx %>"
                            aria-expanded="false">
                      <%= ("#{@channel} #{channel_last4}").gsub(" ", "_") %>
                    </button>
                  </h2>

                  <div id="collapse-channel-<%= ch_idx %>" class="accordion-collapse collapse">
                    <div class="accordion-body p-2">

                      <% months.each_with_index do |(month, days), month_idx| %>
                        <% month_sum = days.values.flatten.sum(&:transaction_amount) %>

                        <div class="accordion mb-1">
                          <div class="accordion-item">
                            <h2 class="accordion-header" id="heading-month-<%= ch_idx %>-<%= month_idx %>">
                              <button class="accordion-button collapsed d-flex justify-content-between py-1" type="button"
                                      data-bs-toggle="collapse"
                                      data-bs-target="#collapse-month-<%= ch_idx %>-<%= month_idx %>"
                                      aria-expanded="false">
                                <div class="gap-2">
                                  <span><%= month %></span>
                                  <span>Total: <%= month_sum %></span>
                                </div>
                              </button>
                            </h2>

                            <div id="collapse-month-<%= ch_idx %>-<%= month_idx %>" class="accordion-collapse collapse">
                              <div class="accordion-body">
                                <% days.each do |day, day_records| %>
                                  <div style="max-height: 300px; overflow-y: auto;">
                                    <table class="table table-sm table-bordered mb-0">
                                      <thead>
                                        <tr>
                                          <th>Date & Time</th>
                                          <th>Transaction Amount</th>
                                        </tr>
                                      </thead>
                                      <tbody>
                                        <% day_records.each do |r| %>
                                          <tr>
                                            <td><%= r.transaction_datetime&.strftime("%d-%m-%Y %H:%M") %></td>
                                            <td><%= r.transaction_amount %></td>
                                          </tr>
                                        <% end %>
                                      </tbody>
                                    </table>
                                  </div>
                                <% end %>
                              </div>
                            </div>
                          </div>
                        </div>
                      <% end %>

                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
