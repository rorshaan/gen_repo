<div class="container mt-4">
	<div class="row">
		<div class="col-lg-12">
			<div class="card text-center mb-2">
				<div class="card-header">
					<h1 >File Uploads</h1>
				</div>
			</div>
		</div>

		<div class="table-responsive">
			<table class="table table-striped table-bordered table-hover align-middle">
			  <thead class="table-primary">
			    <tr>
			      <th>User</th>
			      <th>Channel Name</th>
			      <th>File</th>
			      <th>Status</th>
			      <th>Uploaded At</th>
			      <th>Total Rows</th>
			      <th>Inserted</th>
			      <th>Rejected</th>
			      <th>Actions</th>
			    </tr>
			  </thead>
			  <tbody>
			    <% @import_files.each do |file| %>
			      <tr>
			        <td><%= file.user.email %></td>
			        <td><%= file.channel_name %></td>
			        <td>
			          <%= link_to File.basename(file.file_path), download_import_file_path(file), target: "_blank", class: "text-decoration-none" %>
			        </td>
			        <td>
			          <span class="badge bg-<%= status_color(file.status) %>">
			            <%= file.status.humanize %>
			          </span>
			        </td>
			        <td><%= file.created_at.strftime("%d %b %Y %H:%M") %></td>

      				<td><%= file.total_rows || "-" %></td>
      				
      				<td><%= file.processed_count || 0 %></td>
      				<td>
				        <%= file.rejected_count || 0 %>
				      </td>
			        <td>
							  <div class="dropdown">
							    <button class="btn btn-primary dropdown-toggle" type="button" id="actionsMenu<%= file.id %>" data-bs-toggle="dropdown" aria-expanded="false">
							      Actions
							    </button>
							    <ul class="dropdown-menu" aria-labelledby="actionsMenu<%= file.id %>">
							      <li>
							        <%= link_to "View", import_file_path(file), class: "dropdown-item" %>
							      </li>
							      <% if file.file_path.present? %>
							        <li>
							          <%= link_to "Download", download_import_file_path(file), class: "dropdown-item", data: { turbo: false } %>
							        </li>
							      <% end %>
							      <% if file.error_file_path.present? %>
							        <li>
							          <%= link_to "Rejected CSV", download_rejected_import_file_path(file), class: "dropdown-item", data: { turbo: false } %>
							        </li>
							      <% end %>
							    </ul>
							  </div>
							</td>
			      </tr>
			    <% end %>
			  </tbody>
			</table>
		</div>
		<div class="d-flex justify-content-center">
			<%= paginate @import_files %>
		</div>
	</div>
</div>
