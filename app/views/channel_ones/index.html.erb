<div class="container mt-4">
  <div class="row">
    <div class="col-lg-12">
      <div class="card text-center mb-2">
        <div class="card-header">
          <h1 >Channel One</h1>
        </div>
      </div>
    </div>

    <% if @channel_ones.any? %>
      <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover align-middle">
          <thead class="table-primary">
            <tr>
              <th>Transaction ID</th>
              <th>Sender Msisdn</th>
              <th>Transaction Amount</th>
              <th>Transaction Date & Time</th>
              <th>Transaction Type</th>
              <th>Receiver Msisdn</th>
              <th>Service Name</th>
              <th>Transaction Status</th>
              <th>Reference Number</th>
              <th>Previous Balance</th>
              <th>Post Balance</th>
              <th>External Transaction ID</th>
            </tr>
          </thead>
          <tbody>
            <% @channel_ones.each_with_index do |channel_one, index| %>
              <tr>
                <td><%= channel_one.transaction_id %></td>
                <td><%= channel_one.sender_msisdn %></td>
                <td><%= channel_one.transaction_amount %></td>
                <td><%= channel_one.transaction_datetime&.strftime("%d-%m-%Y %H:%M") %></td>
                <td><%= channel_one.transaction_type %></td>
                <td><%= channel_one.receiver_msisdn %></td>
                <td><%= channel_one.service_name %></td>
                <td>
                  <% if channel_one.transaction_status == "Success" %>
                    <span class="badge bg-success">Success</span>
                  <% else %>
                    <span class="badge bg-danger"><%= channel_one.transaction_status %></span>
                  <% end %>
                </td>
                <td><%= channel_one.reference_number %></td>
                <td><%= channel_one.previous_balance %></td>
                <td><%= channel_one.post_balance %></td>
                <td><%= channel_one.external_transaction_id %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="alert alert-info">No Channel Record found.</div>
    <% end %>

    <div class="d-flex justify-content-center">
      <%= paginate @channel_ones %>
    </div>
  </div>
</div>


