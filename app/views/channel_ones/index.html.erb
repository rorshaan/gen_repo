<div class="container mt-4">
  <div class="row">
    <div class="col-lg-12">
      <div class="card text-center mb-2">
        <div class="card-header">
          <h1>Channel One</h1>
        </div>
      </div>
    </div>

    <% if @import_files.any? %>
      <%= render "shared/accordion",
                 association: :channel_ones,
                 headers: ["Transaction ID", "Sender Msisdn", "Transaction Amount", "Transaction Date & Time",
                           "Transaction Type", "Receiver Msisdn", "Service Name", "Status",
                           "Reference Number", "Previous Balance", "Post Balance", "External Transaction ID"],
                 row_partial: "channel_ones/row" %>
    <% else %>
      <div class="alert alert-info">No Channel Record found.</div>
    <% end %>

    <div class="d-flex justify-content-center mt-3">
      <%= paginate @import_files %>
    </div>
  </div>
</div>
