<div class="container mt-4">
  <div class="row">
    <div class="col-lg-12">
      <div class="card text-center mb-2">
        <div class="card-header">
          <h1>Channel Two</h1>
        </div>
      </div>
    </div>

    <% if @import_files.any? %>
      <%= render "shared/accordion",
                 association: :channel_twos,
                 headers: ["Receipt No.", "Completion Time", "Initiation Time", "Details",
                           "Transaction Status", "Currency", "Paid In", "Withdrawn",
                           "Balance", "Reason Type", "Opposite Party", "Linked Transaction ID"],
                 row_partial: "channel_twos/row" %>
    <% else %>
      <div class="alert alert-info">No Channel Record found.</div>
    <% end %>

    <div class="d-flex justify-content-center mt-3">
      <%= paginate @import_files %>
    </div>
  </div>
</div>
