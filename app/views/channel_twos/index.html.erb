<div class="container mt-4">
  <h1 class="mb-4">Deposits</h1>

  <% if @channel_twos.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-bordered table-hover align-middle">
        <thead class="table-primary">
          <tr>
            <th>Receipt No.</th>
            <th>Completion Time</th>
            <th>Initiation Time</th>
            <th>Details</th>
            <th>Transaction Status</th>
            <th>Currency</th>
            <th>Paid In</th>
            <th>Withdrawn</th>
            <th>Balance</th>
            <th>Reason Type</th>
            <th>Opposite Party</th>
            <th>Linked Transaction ID</th>
          </tr>
        </thead>
        <tbody>
          <% @channel_twos.each_with_index do |channel_two, index| %>
            <tr>
              <td><%= channel_two.receipt_no %></td>
              <td><%= channel_two.completion_time&.strftime("%d-%m-%Y %H:%M") %></td>
              <td><%= channel_two.initiation_time&.strftime("%d-%m-%Y %H:%M") %></td>
              <td><%= channel_two.details %></td>
              <td>
                <% if channel_two.transaction_status == "Success" %>
                  <span class="badge bg-success">Success</span>
                <% else %>
                  <span class="badge bg-danger"><%= channel_two.transaction_status %></span>
                <% end %>
              </td>
              <td><%= channel_two.currency %></td>
              <td><%= channel_two.paid_in %></td>
              <td><%= channel_two.withdrawn %></td>
              <td><%= channel_two.balance %></td>
              <td><%= channel_two.reason_type %></td>
              <td><%= channel_two.opposite_party %></td>
              <td><%= channel_two.linked_transaction_id %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">No Channel Record found.</div>
  <% end %>
  <div class="d-flex justify-content-center">
    <%= paginate @channel_twos %>
  </div>
</div>


